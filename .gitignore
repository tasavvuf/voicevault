# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Environment & secrets (strictly prevent accidental leaks)
.env
.env.*
.env*.local
*.env
*.env.*
!*.env.example
!server/.env.example

# dependencies
node_modules/
package-lock.json.backup

# Expo & Web
.expo/
dist/
web-build/
expo-env.d.ts

# Native builds & keystores
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
/ios/
/android/

# Metro
.metro-health-check*

# debug & logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
*.log

# macOS & OS artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# IDEs & Editors
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# typescript & build
*.tsbuildinfo
example

# Server artifacts & uploads
server/.env
server/.env.*
!server/.env.example
server/uploads/
uploads/
coverage/
